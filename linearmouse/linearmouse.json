{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.10.0",
  "schemes" : [
    {
      "scrolling" : {
        "speed" : {
          "vertical" : 0
        },
        "acceleration" : {
          "vertical" : 1
        },
        "distance" : {
          "vertical" : "auto"
        }
      },
      "pointer" : {
        "disableAcceleration" : true
      },
      "if" : {
        "device" : {
          "productID" : "0x0",
          "vendorID" : "0x0",
          "category" : "trackpad",
          "productName" : "Apple Internal Keyboard \/ Trackpad"
        }
      }
    }
  ]
}