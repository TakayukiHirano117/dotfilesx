// Place your key bindings in this file to override the defaults
[
  {
    "key": "cmd+i",
    "command": "composerMode.agent",
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.previousEditor",
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.nextEditor",
  },
  {
    "key": "alt+cmd+right",
    "command": "-workbench.action.nextEditor",
  },
  {
    "key": "shift+cmd+c",
    "command": "copyRelativeFilePath",
    "when": "!editorFocus",
  },
  {
    "key": "shift+alt+cmd+c",
    "command": "-copyRelativeFilePath",
    "when": "!editorFocus",
  },
  {
    "key": "ctrl+n",
    "command": "workbench.view.explorer", // エクスプローラ表示
    "when": "!explorerViewletVisible",
  },
  {
    "key": "ctrl+n",
    "command": "workbench.action.closeSidebar", // 閉じる
    "when": "explorerViewletVisible",
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "explorerViewletVisible && listFocus && !inputFocus",
  },
  {
    "key": "l",
    "command": "list.expand",
    "when": "explorerViewletVisible && listFocus && !inputFocus",
  },
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "explorerViewletVisible && listFocus && !inputFocus",
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "explorerViewletVisible && listFocus && !inputFocus",
  },
  {
    "key": "enter",
    "command": "list.select",
    "when": "explorerViewletVisible && listFocus",
  },
  {
    "key": "space",
    "command": "workbench.files.action.focusFilesExplorer",
    "when": "editorTextFocus && neovim.mode == 'normal'",
  },
  {
    "key": "space",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "explorerViewletVisible && listFocus",
  },
  {
    "key": "ctrl+e",
    "command": "workbench.view.extensions",
  },
  {
    "key": "ctrl+j",
    "command": "workbench.view.search",
  },
  {
    "key": "ctrl+f",
    "command": "workbench.action.findInFiles",
  },
  {
    "key": "ctrl+g",
    "command": "workbench.view.scm",
  },
  {
    "key": "ctrl+shift+f",
    "command": "workbench.action.tasks.runTask",
    "args": "Vitest: Current File",
  },
  {
    "key": "ctrl+shift+r",
    "command": "workbench.action.tasks.runTask",
    "args": "Vitest: Current Line",
  },
  {
    "key": "ctrl+shift+h",
    "command": "workbench.action.moveEditorLeftInGroup",
  },
  {
    "key": "ctrl+shift+l",
    "command": "workbench.action.moveEditorRightInGroup",
  },
  {
    "key": "ctrl+shift+k",
    "command": "claude-code.insertAtMentioned",
    "when": "editorTextFocus",
  },
  {
    "key": "alt+cmd+k",
    "command": "-claude-code.insertAtMentioned",
    "when": "editorTextFocus",
  },
  {
    "key": "alt+cmd+s",
    "command": "workbench.action.toggleUnifiedSidebarFromKeyboard",
    "when": "!isAuxiliaryWindowFocusedContext",
  },
  {
    "key": "alt+o",
    "command": "chatgpt.addToThread",
  },
  // {
  //   "key": "ctrl+shift+l",
  //   "command": "workbench.action.tasks.runTask",
  //   "args": "pest sail (Filter)"
  // },
  // {
  //   "key": "ctrl+shift+f",
  //   "command": "workbench.action.tasks.runTask",
  //   "args": "pest sail (Current File)"
  // },
]
