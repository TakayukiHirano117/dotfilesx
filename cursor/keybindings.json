// Place your key bindings in this file to override the defaults
[
  {
    "key": "cmd+i",
    "command": "composerMode.agent",
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.previousEditor",
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.nextEditor",
  },
  {
    "key": "alt+cmd+right",
    "command": "-workbench.action.nextEditor",
  },
  {
    "key": "shift+cmd+c",
    "command": "copyRelativeFilePath",
    "when": "!editorFocus",
  },
  {
    "key": "shift+alt+cmd+c",
    "command": "-copyRelativeFilePath",
    "when": "!editorFocus",
  },
  {
    "key": "ctrl+n",
    "command": "workbench.view.explorer", // エクスプローラ表示
    "when": "!explorerViewletVisible",
  },
  {
    "key": "ctrl+n",
    "command": "workbench.action.closeSidebar", // 閉じる
    "when": "explorerViewletVisible",
  },
  {
    "key": "h",
    "command": "list.collapse",
    "when": "explorerViewletVisible && listFocus && !inputFocus",
  },
  {
    "key": "l",
    "command": "list.expand",
    "when": "explorerViewletVisible && listFocus && !inputFocus",
  },
  {
    "key": "j",
    "command": "list.focusDown",
    "when": "explorerViewletVisible && listFocus && !inputFocus",
  },
  {
    "key": "k",
    "command": "list.focusUp",
    "when": "explorerViewletVisible && listFocus && !inputFocus",
  },
  {
    "key": "enter",
    "command": "list.select",
    "when": "explorerViewletVisible && listFocus && !inputFocus",
  },
  {
    "key": "space",
    "command": "workbench.action.focusSideBar",
    "when": "editorTextFocus && neovim.mode == 'normal'",
  },
  {
    "key": "space",
    "command": "-list.select",
    "when": "explorerViewletVisible && listFocus && !inputFocus",
  },
  {
    "key": "space",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "explorerViewletVisible && listFocus && !inputFocus",
  },
  {
    "key": "ctrl+e",
    "command": "workbench.view.extensions",
  },
  {
    "key": "ctrl+j",
    "command": "workbench.view.search",
  },
  {
    "key": "ctrl+shift+r",
    "command": "workbench.action.tasks.runTask",
    "args": "RSpec in Docker (Current Line)",
  },
  {
    "key": "ctrl+shift+f",
    "command": "workbench.action.tasks.runTask",
    "args": "RSpec in Docker (Entire File)",
  },
  {
    "key": "ctrl+shift+a",
    "command": "workbench.action.tasks.runTask",
    "args": "RSpec in Docker (All Tests)",
  },
  {
    "key": "ctrl+g",
    "command": "workbench.view.scm",
  },
  {
    "key": "ctrl+shift+t",
    "command": "workbench.action.tasks.runTask",
    "args": "Jest: Current Line",
  },
  {
    "key": "ctrl+shift+z",
    "command": "workbench.action.tasks.runTask",
    "args": "Jest: Selected Test",
  },
  {
    "key": "ctrl+shift+w",
    "command": "workbench.action.tasks.runTask",
    "args": "Playwright: Current File",
  },
  {
    "key": "ctrl+shift+q",
    "command": "workbench.action.tasks.runTask",
    "args": "Playwright: Current Line",
  },
