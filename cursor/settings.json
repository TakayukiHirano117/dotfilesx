{
  // ── Editor ──────────────────────────────────────────
  "editor.fontFamily": "'Source Code Pro', Consolas, monospace",
  "editor.fontSize": 16,
  "editor.lineHeight": 1.5,
  "editor.tabSize": 2,
  "editor.wordWrap": "off",
  "editor.rulers": [80, 120],
  "editor.renderWhitespace": "none",
  "editor.renderLineHighlight": "all",
  "editor.smoothScrolling": true,
  "editor.accessibilitySupport": "off",
  "editor.stickyScroll.enabled": false,
  "editor.formatOnSave": true,
  "editor.codeLens": true,
  "editor.inlayHints.enabled": "on",
  "editor.linkedEditing": true,
  "editor.suggestSelection": "first",
  "editor.tabCompletion": "on",
  "editor.rename.enablePreview": false,
  "editor.peekWidgetDefaultFocus": "editor",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.guides.highlightActiveBracketPair": true,
  "editor.guides.indentation": false,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleDeclarations": "goto",

  // ── Diff ────────────────────────────────────────────
  "diffEditor.wordWrap": "off",
  "diffEditor.ignoreTrimWhitespace": false,

  // ── Files ───────────────────────────────────────────
  "files.autoSave": "afterDelay",
  "files.enableTrash": false,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/.idea": true,
    "**/node_modules": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/tmp/**": true,
    "**/vendor/**": true,
    "**/Library/**": true,
    "**/Temp/**": true
  },

  // ── Search ──────────────────────────────────────────
  "search.exclude": {
    "**/coverage": true,
    "**/dist": true,
    "**/vendor": true,
    "**/Library": true,
    "**/Temp": true,
    "**/Logs": true,
    "**/Obj": true
  },

  // ── Explorer ────────────────────────────────────────
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": true,
  "explorer.confirmDelete": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "go.mod": "go.sum"
  },

  // ── Workbench ───────────────────────────────────────
  "workbench.sideBar.location": "left",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.colorTheme": "Atom One Dark",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.editor.enablePreview": false,
  "workbench.colorCustomizations": {
    "editor.lineHighlightBackground": "#1073cf2d",
    "editor.lineHighlightBorder": "#9fced11f",
    "list.activeSelectionBackground": "#b4b4b4",
    "list.activeSelectionForeground": "#ffffff",
    "list.focusOutline": "#fb00ff",
    "list.hoverBackground": "#83838327",
    "errorLens.errorBackground": "#ff000033",
    "errorLens.errorMessageBackground": "#00000000"
  },

  // ── SCM / Git ───────────────────────────────────────
  "scm.defaultViewMode": "tree",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,

  // ── Terminal ────────────────────────────────────────
  "terminal.integrated.defaultLocation": "view",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.fontFamily": "'Source Code Pro', Consolas, monospace",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.defaultProfile.osx": "fish",
  "terminal.integrated.profiles.osx": {
    "fish": {
      "path": "/opt/homebrew/bin/fish"
    }
  },

  // ── Prettier ────────────────────────────────────────
  "prettier.singleQuote": true,
  "prettier.trailingComma": "es5",

  // ── Go ──────────────────────────────────────────────
  // https://github.com/golang/vscode-go/wiki/settings
  "go.useLanguageServer": true,
  "go.toolsManagement.autoUpdate": true,
  "go.lintTool": "golangci-lint-v2",
  "go.lintOnSave": "package",
  "go.testFlags": ["-v"],
  "go.coverOnSingleTest": true,
  "go.diagnostic.vulncheck": "Imports",
  "go.inlayHints.parameterNames": true,
  "go.inlayHints.assignVariableTypes": true,
  "go.inlayHints.compositeLiteralFields": true,
  "go.inlayHints.constantValues": true,
  "go.inlayHints.rangeVariableTypes": true,
  "gopls": {
    "ui.diagnostic.staticcheck": true,
    "ui.completion.usePlaceholders": true
  },

  // ── Proto / Buf (gRPC) ──────────────────────────────
  // https://buf.build/docs/ide/vs-code/
  "files.associations": {
    "*.proto": "proto"
  },

  // ── Ruby (ruby-lsp) ─────────────────────────────────
  "ruby.lsp.useLanguageServer": true,
  "ruby.lint": {
    "rubocop": true
  },

  // ── YAML (workflow schema 誤検出を抑制) ─────────────
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],

  // ── Language formatters ─────────────────────────────
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[proto]": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnSave": true
  },
  "[erb]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },

  // ── Extensions ────────────────────────────────────
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "errorLens.enabled": true,

  // ── vscode-neovim ───────────────────────────────────
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },

  // ── Cursor / AI ─────────────────────────────────────
  "cursor.composer.usageSummaryDisplay": "always",
  "cursor.composer.shouldAutoAcceptDiffs": false,
  "cursor.cpp.disabledLanguages": ["plaintext"],
  "claudeCode.preferredLocation": "panel",
  "claudeCode.selectedModel": "haiku",
  "claudeCode.useTerminal": true,

  // ── Window ──────────────────────────────────────────
  "window.autoDetectColorScheme": false
}
