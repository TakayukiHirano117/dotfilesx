{
  "files.autoSave": "afterDelay",
  "workbench.iconTheme": "material-icon-theme",
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "editor.renderWhitespace": "none",
  "editor.guides.bracketPairs": false,
  "editor.lineHeight": 1.5,
  "editor.fontSize": 16,
  "editor.fontFamily": "'Source Code Pro', Consolas, monospace",
  "editor.tabSize": 2,
  "editor.rulers": [80, 120],
  "editor.wordWrap": "off",
  "files.exclude": {
    "**/.idea": true,
    "**/node_modules": true,
  },
  "search.exclude": {
    "**/coverage": true,
    "**/dist": true,
  },
  "workbench.settings.applyToAllProfiles": [],
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/tmp/**": true,
  },
  "editor.accessibilitySupport": "off",
  "editor.smoothScrolling": true,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "es5",
  "eslint.validate": ["javascript", "typescript"],
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "terminal.integrated.fontSize": 16,
  "workbench.editor.enablePreview": false,
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"],
    },
  ],
  "vim.hlsearch": true,
  "workbench.colorTheme": "Atom One Dark",
  "[erb]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
  },
  "laravel-pint.enable": true,
  "editor.formatOnSave": true,
  "[blade]": {
    "editor.defaultFormatter": "shufo.vscode-blade-formatter",
  },
  "[php]": {
    "editor.defaultFormatter": "DEVSENSE.phptools-vscode",
  },
  "explorer.compactFolders": false,
  "editor.gotoLocation.multipleTypeDefinitions": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "ruby.format": "rubocop",
  "ruby.lsp.useLanguageServer": true,
  "ruby.intellisense": "rubyLocate",
  "ruby.lint": {
    "rubocop": true,
  },
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnSave": true,
  },
  "bracket-pair-colorizer-2.depreciation-notice": false,
  "editor.renderLineHighlight": "all", // カーソル行全体をハイライト
  "workbench.colorCustomizations": {
    "editor.lineHighlightBackground": "#1073cf2d",
    "list.activeSelectionBackground": "#b4b4b4",
    "list.activeSelectionForeground": "#ffffff",
    "list.focusOutline": "#fb00ff",
    "list.hoverBackground": "#83838327",
    "editor.lineHighlightBorder": "#9fced11f",
  },
  "errorLens.enabled": true,
  "errorLens.errorBackground": "#ff000033", // エラー行を薄い赤でハイライト
  "errorLens.errorMessageBackground": "#00000000",
  "editor.stickyScroll.enabled": false,
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // "synthwave84.brightness": 1,
  // "synthwave84.disableGlow": false
  // "bookmarks.gutterIconFillColor": "#FF8800",
  // "bookmarks.gutterIconBorderColor": "#FFFFFF",
  // "workbench.colorCustomizations": {
  //   "bookmarks.lineBackground": "rgba(255, 136, 0, 0.3)",
  //   "bookmarks.lineBorder": "#FF8800",
  //   "bookmarks.overviewRuler": "#FF8800"
  // }
  // "bracket-pair-colorizer-2.colors": ["#b4b4b4", "#b4b4b4"],
  // "bracket-pair-colorizer-2.colorMode": "Consecutive",
  "blockman.n04ColorComboPreset": "Classic Light (Gradients)",
  "editor.inlayHints.enabled": "on",
  "diffEditor.wordWrap": "off",
  "editor.guides.indentation": false,
  "apc.imports": [
    "file:///Users/takayukihirano117/.cursor/extensions/brandonkirbyson.vscode-animations-2.0.1-universal/dist/updateHandler.js",
  ],
  "hediet.vscode-drawio.resizeImages": null,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.defaultProfile.osx": "fish",
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  //   "indentRainbow.colors": [
  //   "rgba(255, 99, 132, 0.35)",
  //   "rgba(54, 162, 235, 0.35)",
  //   "rgba(255, 206, 86, 0.35)",
  //   "rgba(75, 192, 192, 0.35)",
  //   "rgba(153, 102, 255, 0.35)"
  // ],
  // "indentRainbow.indicatorStyle": "classic"
  "explorer.confirmDragAndDrop": true,
  "explorer.confirmDelete": true,
  "files.enableTrash": false,
  "terminal.integrated.profiles.osx": {
    "fish": {
      "path": "/opt/homebrew/bin/fish",
    },
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "cursor.composer.usageSummaryDisplay": "always",
  "claudeCode.preferredLocation": "panel",
  "claudeCode.selectedModel": "haiku",
  "cursor.composer.shouldAutoAcceptDiffs": false,
  "claudeCode.useTerminal": true,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "window.autoDetectColorScheme": false,
  "editor.codeLens": true,
  "cursor.cpp.disabledLanguages": ["plaintext"],
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
  ],
  "go.inlayHints.parameterNames": true,
  "go.toolsManagement.autoUpdate": true,
  // "workbench.editorAssociations": {
  //   "*.bin": "hexEditor.hexedit"
  // }
}
